.DS_Store
.build/
.swiftpm/
apps/ingest-simulator/.bin/
dist/
# Per-user Xcode state: window layout, breakpoints, scheme ordering. Never
# shared. `xcshareddata/` (schemes, Package.resolved) is deliberately *not*
# ignored — that part is meant to be committed.
xcuserdata/
UserInterfaceState.xcuserstate
# Per-developer signing configuration: the Apple Developer Team ID is an
# account identifier personal to whoever builds, so it stays out of the tracked
# project files. Copy Local.xcconfig.example (committed) to Local.xcconfig.
Local.xcconfig
