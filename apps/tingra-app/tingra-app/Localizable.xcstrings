{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (Not connected)" : {
      "comment" : "Picker entry for a selected device that is not currently connected",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (nicht verbunden)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (no conectado)"
          }
        }
      }
    },
    "%@ copy" : {
      "comment" : "Name of a duplicated shot or preset; the placeholder is the source's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Kopie"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ copia"
          }
        }
      }
    },
    "%@ of room left" : {
      "comment" : "How much recording time the chosen volume still holds",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch %@ Platz"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queda espacio para %@"
          }
        }
      }
    },
    "%@ will be removed from the preset. This cannot be undone." : {
      "comment" : "Confirmation alert message before deleting a shot; the placeholder is the shot's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird aus der Voreinstellung entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se eliminará del preajuste. Esta acción no se puede deshacer."
          }
        }
      }
    },
    "● Live" : {
      "comment" : "Stream status: the program is on air",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "● Live"
          }
