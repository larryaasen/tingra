    },
    "The folder %@ could not be created: %@" : {
      "comment" : "Snapshot Not Saved badge tooltip: the snapshots folder could not be created; the placeholders are the folder and the system's reason",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
