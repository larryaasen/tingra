    "Appearance, status bar, monitor output, recording folder and format, sidebar sections, and window positions." : {
      "comment" : "Data settings: what the preferences hold",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erscheinungsbild, Statusleiste, Monitorausgabe, Aufnahmeordner und -format, Seitenleistenbereiche und Fensterpositionen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apariencia, barra de estado, salida del monitor, carpeta y formato de grabación, secciones de la barra lateral y posiciones de las ventanas."
          }
        }
      }
    },
    "Appearance, status bar, monitor output, recording folder and format, sidebar sections, the last preset and shots on program and preview, and window positions." : {
      "comment" : "Data settings: what the preferences hold",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erscheinungsbild, Statusleiste, Monitorausgabe, Aufnahmeordner und -format, Seitenleistenbereiche, die zuletzt aktive Voreinstellung mit den Einstellungen auf Programm und Vorschau sowie Fensterpositionen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apariencia, barra de estado, salida del monitor, carpeta y formato de grabación, secciones de la barra lateral, el último preajuste y las tomas en programa y previsualización, y posiciones de las ventanas."
          }
        }
      }
    },
    "Applied in order, top to bottom" : {
      "comment" : "Caption under an effect chain's heading: the effects run in the listed order",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angewendet in Reihenfolge, von oben nach unten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicados en orden, de arriba abajo"
          }
        }
      }
    },
    "Apply" : {
      "comment" : "Custom program size sheet: applies the typed format",
      "localizations" : {
