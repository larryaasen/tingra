{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (%@)" : {
      "comment" : "Shot bank tile caption: the shot's name, then the shortcut that stages it, e.g. Default (⌘1)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ (Not connected)" : {
      "comment" : "Picker entry for a selected device that is not currently connected",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (nicht verbunden)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (no conectado)"
          }
        }
      }
    },
    "%@ and its stored stream key will be removed. This cannot be undone." : {
      "comment" : "Confirmation alert message before deleting a destination; the placeholder is the destination's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ und der gespeicherte Streamschlüssel werden entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ y su clave de emisión guardada se eliminarán. Esta acción no se puede deshacer."
          }
        }
      }
    },
    "%@ copy" : {
      "comment" : "Name of a duplicated shot or preset; the placeholder is the source's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Kopie"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ copia"
          }
        }
      }
    },
    "%@ of room left" : {
      "comment" : "How much recording time the chosen volume still holds",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch %@ Platz"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queda espacio para %@"
          }
        }
      }
    },
    "%@ will be removed from the preset. This cannot be undone." : {
      "comment" : "Confirmation alert message before deleting a shot; the placeholder is the shot's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird aus der Voreinstellung entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se eliminará del preajuste. Esta acción no se puede deshacer."
          }
        }
      }
    },
    "%@, %@" : {
      "comment" : "Data settings: a count of files or entries, then their size on disk",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
