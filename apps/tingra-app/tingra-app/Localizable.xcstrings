          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo crear la carpeta %1$@: %2$@"
          }
        }
      }
    },
    "The frame rate must be between 1 and 240." : {
      "comment" : "Custom program size sheet: the frame rate is out of range",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bildrate muss zwischen 1 und 240 liegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frecuencia de fotogramas debe estar entre 1 y 240."
          }
        }
      }
    },
    "The log file is kept: %@ in %@." : {
      "comment" : "Confirmation alert message closing line: the log file is kept; the placeholders are how much there is and the folder",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Protokolldatei bleibt erhalten: %1$@ in %2$@."
