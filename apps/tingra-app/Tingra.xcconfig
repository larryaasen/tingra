//
//  Tingra.xcconfig
//  tingra-app
//
//  Created by Larry Aasen on 2026-08-01.
//  Copyright © 2026 Larry Aasen.
//  SPDX-License-Identifier: MIT
//
//  The project's base configuration. It exists to keep the signing team — an
//  Apple Developer account identifier, personal to whoever builds — out of the
//  tracked project file, so this repository can be public without carrying one
//  developer's account into everyone else's checkout.
//
//  `Local.xcconfig` is git-ignored and holds that one value. The `#include?`
//  form is an *optional* include: the build works with the file absent, which
//  is what CI does (it passes CODE_SIGNING_ALLOWED=NO and needs no team at
//  all). To build a signed, runnable app locally, copy Local.xcconfig.example
//  to Local.xcconfig and fill in your team.
//
//  The include must come first — in an xcconfig the last assignment wins, so
//  DEVELOPMENT_TEAM below reads whatever Local.xcconfig set.

#include? "Local.xcconfig"

DEVELOPMENT_TEAM = $(TINGRA_DEVELOPMENT_TEAM)

//  The product version, the number `tingra-cli version` prints: the app and
//  its embedded Notes extension take it for both CFBundleShortVersionString
//  and CFBundleVersion (RELEASE.md, Decision 6). scripts/release-cli.sh bumps
//  this line together with TingraCLIVersion.current and the CLI's Info.plist,
//  and refuses to go on if the three disagree. Between releases it carries the
//  next version with a -dev suffix, as they do.
TINGRA_VERSION = 0.1.4-dev

//  Apple Silicon only, in every configuration (CLAUDE.md, "Platform Support").
//  Without this a Release build for a generic Mac destination — which is what
//  `xcodebuild archive` uses — is universal, and its x86_64 slice cannot link:
//  the prebuilt libsrt HaishinKit's SRT output carries is arm64 only. Day-to-day
//  builds never showed it because they name `arch=arm64` in the destination
//  (RELEASE.md, "Spike findings", row B).
ARCHS = arm64

//  The provisioning profile the app target signs with, by name: empty here, so
//  development builds keep automatic signing, and set on the command line by
//  the release, which archives with the Developer ID identity and manual
//  signing (RELEASE.md, Decision 3). Only the app target reads it. A profile
//  named in PROVISIONING_PROFILE_SPECIFIER directly would reach every target —
//  the Notes extension and both kit frameworks refuse a profile issued for
//  another bundle — which is why the app's setting points here instead.
TINGRA_APP_PROFILE_SPECIFIER =
