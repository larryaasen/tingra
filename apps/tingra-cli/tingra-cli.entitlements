<?xml version="1.0" encoding="UTF-8"?>
<!--
  tingra-cli.entitlements
  tingra-cli

  Created by Larry Aasen on 2026-07-09.
  Copyright © 2026 Larry Aasen.
  SPDX-License-Identifier: MIT

  Applied by scripts/release-cli-package.sh at signing (see CLI.md, "Distribution").
  Notarization requires the hardened runtime, which denies camera and
  microphone access unless the binary opts in — hence the two device
  entitlements. disable-library-validation lets the host load third-party
  plug-ins signed by other teams (ARCHITECTURE.md). No sandbox entitlement:
  Tingra is deliberately unsandboxed.

  keychain-access-groups puts this binary and Tingra.app in one data-protection
  keychain group, so the daemon can read a stream key the operator filed in the
  app (DESTINATIONS.md, "Key sharing between the app and the daemon"). The
  value carries the $(TeamIdentifierPrefix) build variable, never a literal
  Team ID — nothing personal in a tracked file (CLAUDE.md, "Signing"). Xcode
  expands that variable itself; `codesign` does not, so release-cli-package.sh
  substitutes the Team ID out of TINGRA_SIGN_ID into a temporary copy at
  signing time. An unsigned `swift build` binary has no entitlements at all and
  therefore no access group: destination names and URLs still resolve, and a
  key it cannot read is reported as absent with a message naming the fix.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>keychain-access-groups</key>
    <array>
        <string>$(TeamIdentifierPrefix)com.moonwink.tingra.shared</string>
    </array>
</dict>
</plist>
