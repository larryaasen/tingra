{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@" : {
      "comment" : "About settings: an uptime of hours then minutes, e.g. “1 hour” then “43 min”",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ is not connected" : {
      "comment" : "Tooltip on a camera preset whose camera is unplugged; the placeholder is its name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist nicht angeschlossen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está conectada"
          }
        }
      }
    },
    "%@ will be deleted. This cannot be undone." : {
      "comment" : "Delete Preset dialog message; the placeholder is the preset's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminará «%@». Esta acción no se puede deshacer."
          }
        }
      }
    },
