        }
      }
    },
    "Drag to pan and tilt. Pinch or Option-scroll to zoom." : {
      "comment" : "Tooltip on the live preview explaining how to frame the camera by hand.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Schwenken und Neigen ziehen. Zum Zoomen mit zwei Fingern auf- oder zuziehen oder mit gedrückter Wahltaste scrollen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para la panorámica y la inclinación. Para hacer zoom, pellizca o desplázate con la tecla Opción."
          }
        }
      }
    },
    "Forget this permission, so macOS asks again the next time a camera opens" : {
      "comment" : "Tooltip on a permission's Reset button",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Berechtigung vergessen, damit macOS beim nächsten Öffnen einer Kamera erneut fragt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvidar este permiso para que macOS vuelva a preguntar la próxima vez que se abra una cámara"
          }
        }
      }
    },
    "General" : {
      "comment" : "Settings window pane: general app settings",
